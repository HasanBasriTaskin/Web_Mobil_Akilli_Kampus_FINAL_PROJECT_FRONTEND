# Environment Variables
# Kopya oluştur: .env.local (development) veya .env.production (production)

# ===========================================
# API Configuration
# ===========================================

# Development: Mock API (Next.js API Routes)
NEXT_PUBLIC_API_URL=/api/v1

# Production: Gerçek Backend API URL'i
# NEXT_PUBLIC_API_URL=https://api.smartcampus.edu/api/v1

# ===========================================
# App Configuration
# ===========================================

# Uygulama adı
NEXT_PUBLIC_APP_NAME=SmartCampus

# Uygulama URL'i
NEXT_PUBLIC_APP_URL=http://localhost:3000
