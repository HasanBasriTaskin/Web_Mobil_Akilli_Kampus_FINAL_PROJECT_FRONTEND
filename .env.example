# Environment Variables
# Kopya oluştur: .env.local (development) veya .env.production (production)

# ===========================================
# API Configuration
# ===========================================

# 1. Ana API URL'si (En yüksek öncelik)
# Eğer bu değer tanımlıysa, uygulamadaki tüm API istekleri doğrudan bu adrese gider.
# Vercel'deki production backend adresi için idealdir. (Sonuna /api/v1 eklemeyi unutmayın)
# Örnek: https://api.smartcampus.taskinnovation.net/api/v1
# NEXT_PUBLIC_FULL_API_URL=https://api.smartcampus.taskinnovation.net/api/v1

# 2. Development / Fallback API URL (Mock API)
# Eğer NEXT_PUBLIC_FULL_API_URL tanımlı DEĞİLSE bu URL çalışır.
# (Genelde yerelde sahte verilerle (Next.js mock API routes) test yapmak için kullanılır)
NEXT_PUBLIC_API_URL=/api/v1

# Backend URL (statik dosyalar için - profil resimleri vb.)
# Development: localhost
NEXT_PUBLIC_BACKEND_URL=https://localhost:7123
# Production:
# NEXT_PUBLIC_BACKEND_URL=https://api.smartcampus.edu

# ===========================================
# App Configuration
# ===========================================

# Uygulama adı
NEXT_PUBLIC_APP_NAME=SmartCampus

# Uygulama URL'i
NEXT_PUBLIC_APP_URL=http://localhost:3000
